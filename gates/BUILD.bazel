"""The gates themselves — one `.rq` per invariant, evaluated by rules_rdf.

`sparql_query_test` is a ZERO-ROW gate: it runs the query and fails the build
if the result set is non-empty. So a gate is one query file plus one target,
adding an invariant needs no Rust rebuild, and when a gate fails the returned
rows *are* the counterexample.

Each gate is wired twice, because a zero-row gate has one dangerous failure
mode: a query that matches nothing because it is MALFORMED looks exactly like
one that matches nothing because the data is clean.

  * `<gate>_passes_on_clean`  — zero rows against a fixture with no violations.
  * `<gate>_detects`          — the query is run over a fixture with KNOWN
                                violations and the result diffed against a
                                committed golden, so both over- and
                                under-matching fail.

The real registry projection (`testdata/registry.ttl`) is wired to a test ONE
GATE AT A TIME, as each reaches zero — see `ENFORCED_ON_REGISTRY`. Until a gate
gets there it is exposed as a `report_*` target to `bazel run`, and regressions
are held off by the ratchet in bazel-registry's PR CI, which fails a PR that
raises any count. Wiring a still-red gate here would just make `//...` red and
train everyone to ignore it.
"""

load("@bazel_skylib//rules:common_settings.bzl", "string_flag")
load("@bazel_skylib//rules:diff_test.bzl", "diff_test")
load("@rules_rdf//rdf:dataset.bzl", "rdf_dataset")
load("@rules_rdf//sparql:defs.bzl", "sparql_query", "sparql_query_smoke_test", "sparql_query_test")
load("//gates:report.bzl", "gate_report")

package(default_visibility = ["//visibility:public"])

GATES = [
    "s4_no_override_in_published_module",
    "d2_undeclared_toolchain_leak",
    "d3_unnamespaced_extension_repo",
    "c1_atom_multi_version",
    "s6_metadata_directory_drift",
    "s7_pg_release_mixing",
]

exports_files([g + ".rq" for g in GATES] + ["declarations.ttl"])

# declarations.ttl is policy input, not a fact: the reviewable allowlist of
# modules that are legitimately toolchain providers. It joins every dataset so
# a gate can consult it.
rdf_dataset(
    name = "declarations",
    srcs = ["declarations.ttl"],
)

rdf_dataset(
    name = "clean",
    srcs = ["testdata/clean.ttl"],
    deps = [":declarations"],
)

rdf_dataset(
    name = "violations",
    srcs = ["testdata/violations.ttl"],
    deps = [":declarations"],
)

# The projection of the live registry, produced by `tbzl-gate project`.
rdf_dataset(
    name = "registry",
    srcs = ["testdata/registry.ttl"],
    deps = [":declarations"],
)

# Every query must parse and execute. Catches a syntax error in a gate that is
# currently returning zero rows for the right reason.
sparql_query_smoke_test(
    name = "all_gates_parse",
    dataset = ":clean",
    queries = [g + ".rq" for g in GATES],
)

[
    sparql_query_test(
        name = g + "_passes_on_clean",
        dataset = ":clean",
        query = g + ".rq",
    )
    for g in GATES
]

# ── Enforced against the LIVE registry projection ───────────────────────────
#
# A gate joins this list the moment its count on the real registry reaches
# zero. From then on it does not merely ratchet — it BLOCKS: any regression in
# the committed projection turns `bazel test //...` red here, alongside the
# bazel-registry ratchet that stops one landing in the first place.
#
# S4 (2026-07-26): cleared by republishing rules_schema_org 0.0.3,
# rules_huggingface 0.0.4, rules_lora 0.1.4 and spec 0.6.3 without their
# local_path_overrides. rules_schema_org 0.0.1 turned out not to build at all
# once its override came off, which is what the invariant is for.
# S7 (2026-07-30): zero on arrival. It was written *with* the leangres modules
# rather than retrofitted to them, so there was never a backlog to burn down —
# and it goes in enforcing rather than reporting so the first cross-major
# publish is blocked instead of counted.
ENFORCED_ON_REGISTRY = [
    "s4_no_override_in_published_module",
    "s7_pg_release_mixing",
]

[
    sparql_query_test(
        name = g + "_holds_on_registry",
        dataset = ":registry",
        query = g + ".rq",
    )
    for g in ENFORCED_ON_REGISTRY
]

[
    sparql_query(
        name = g + "_on_violations",
        dataset = ":violations",
        out_format = "tsv",
        query = g + ".rq",
    )
    for g in GATES
]

[
    diff_test(
        name = g + "_detects",
        file1 = ":" + g + "_on_violations",
        file2 = "testdata/" + g + ".expected.tsv",
    )
    for g in GATES
]

# Reporting over the live registry. `bazel run //gates:report_<gate>` prints
# what that gate would flag today. Not tests — the corpus is not green yet, and
# a red //... would train everyone to ignore it.
[
    sparql_query(
        name = "report_" + g,
        dataset = ":registry",
        out_format = "tsv",
        query = g + ".rq",
    )
    for g in GATES
]

# ---------------------------------------------------------------------------
# The docs.tbzl.dev conformance report
# ---------------------------------------------------------------------------
#
# Gate results, projected into a tomato.gate.v1.ConformanceReport and consumed by
# tomato-bazel/docs. SPARQL JSON on the way in, because it is unambiguous to
# parse — TSV would need literal unquoting and escape handling that fails quietly
# rather than loudly.
#
# A previous revision claimed rules_jena could not emit JSON. That was WRONG:
# running jena_sparql directly emits JSON fine, and so does a fresh Bazel
# target. The zero-byte outputs that prompted the claim were cached action
# results from the window when the Java runtime was misconfigured (Jena 5.2 is
# class-file 61.0, Bazel defaults to 11) and /Volumes/Cache was full. Bazel
# served those empty outputs afterwards; a new target name bypassed them.
#
# The durable lesson is not about formats: gate-report REJECTS an empty results
# file, because a query with no matches still emits a header, so zero bytes
# means the action produced nothing.
#
# The report is a pure function of (projection x queries) — no hidden state,
# nothing fetched — so it regenerates deterministically in CI.

REPORT_QUERIES = GATES + [
    "inventory",
    "c1_atom_selection_by_module",
    "silent_upgrades",
    "declared_atoms",
]

[
    sparql_query(
        name = "rows_" + q,
        dataset = ":registry",
        out_format = "json",
        query = q + ".rq",
    )
    for q in REPORT_QUERIES
]

# Provenance, as build settings rather than baked-in strings, so CI can stamp a
# report without editing a BUILD file:
#
#   bazel build //gates:report \
#     --//gates:generated_at=$(date -u +%Y-%m-%dT%H:%M:%SZ) \
#     --//gates:generated_from=https://github.com/tomato-bazel/bazel-registry@<sha>
#
# Both default to EMPTY. A local `bazel build //gates:report` is therefore
# reproducible — the same projection gives the same bytes — and an unstamped
# report is visibly unstamped rather than quietly claiming to be current.
string_flag(
    name = "generated_at",
    build_setting_default = "",
)

string_flag(
    name = "generated_from",
    build_setting_default = "",
)

gate_report(
    name = "report",
    bom = "@rules_tomato//bom:versions.json",
    declared = ":rows_declared_atoms",
    gate_ids = GATES,
    gate_queries = [g + ".rq" for g in GATES],
    gate_results = [":rows_" + g for g in GATES],
    generated_at = ":generated_at",
    generated_from = ":generated_from",
    inventory = ":rows_inventory",
    selections = ":rows_c1_atom_selection_by_module",
    upgrades = ":rows_silent_upgrades",
)

# The report's own schema, shipped beside it so a consumer can decode the message
# without a copy of the .proto. A `proto_library`'s default output IS its
# descriptor set, so this is a rename, not a build step.
#
# This is what lets tomato-bazel/docs read the report with nothing but
# protobufjs: fetch two files, load the descriptor, decode. No generated client
# to keep in sync, and no second copy of the schema to drift.
genrule(
    name = "conformance_descriptor",
    srcs = ["//proto/tomato/gate/v1:conformance_proto"],
    outs = ["conformance-descriptor.binpb"],
    cmd = "cp $< $@",
)

# What CI publishes: the report plus the schema to read it with.
filegroup(
    name = "report_bundle",
    srcs = [
        ":conformance_descriptor",
        ":report",
    ],
)
