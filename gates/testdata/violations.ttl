# One known violation per gate. Asserting the EXACT rows each query returns is
# what stops a malformed query from masquerading as a passing gate — the main
# failure mode of a zero-row gate, since a query that matches nothing because
# it is wrong looks identical to one that matches nothing because the data is
# clean.
@prefix gate: <https://tbzl.dev/ns/gate#> .

# --- S4: two overrides on one module. -----------------------------------------
# Also the cartesian-product regression: overrides are reified as nodes, so
# this must yield 2 rows, not 4.
<https://tbzl.dev/m/bad_overrides/0.0.1> a gate:ModuleVersion ;
    gate:name "bad_overrides" ;
    gate:version "0.0.1" ;
    gate:isLatest true ;
    gate:namespacePrefix "bad_overrides" ;
    gate:hasOverride <https://tbzl.dev/ovr/bad_overrides/0.0.1/0>,
                     <https://tbzl.dev/ovr/bad_overrides/0.0.1/1> .

<https://tbzl.dev/ovr/bad_overrides/0.0.1/0> a gate:Override ;
    gate:overrideOf <https://tbzl.dev/m/bad_overrides/0.0.1> ;
    gate:overrideDirective "local_path_override" ;
    gate:overrideTarget "rules_jena" .

<https://tbzl.dev/ovr/bad_overrides/0.0.1/1> a gate:Override ;
    gate:overrideOf <https://tbzl.dev/m/bad_overrides/0.0.1> ;
    gate:overrideDirective "local_path_override" ;
    gate:overrideTarget "rules_rdf" .

# --- D2: leaks a toolchain, not a declared provider. --------------------------
<https://tbzl.dev/m/bad_toolchain/0.0.1> a gate:ModuleVersion ;
    gate:name "bad_toolchain" ;
    gate:version "0.0.1" ;
    gate:isLatest true ;
    gate:namespacePrefix "bad_toolchain" ;
    gate:registersToolchain "@rust_toolchains//:all" ;
    gate:registersToolchainDev "@only_mine//:all" .

# D2, the UNSCOPED exemption: a declared provider registering non-dev is exempt
# outright. Kept here rather than leaning on declarations.ttl's real rules_jena
# entry so the fixture proves the clause on its own terms — and so a future edit
# to the live policy cannot quietly change what this test covers.
<https://tbzl.dev/m/rules_whole/1.0.0> a gate:ModuleVersion, gate:RulesModule ;
    gate:name "rules_whole" ;
    gate:version "1.0.0" ;
    gate:isLatest true ;
    gate:namespacePrefix "rules_whole", "whole" ;
    gate:registersToolchain "//whole:a_toolchain_def" ;
    gate:registersToolchain "//whole:b_toolchain_def" .

[] gate:toolchainProviderFor "rules_whole" .

# D2, the SCOPED exemption, and the row that proves it is not a blanket pass:
# `rules_partial` is accountable for its own backend toolchain, so that label is
# exempt — but the `@rust_toolchains//:all` it also leaks is NOT, and must still
# appear in the golden. This is the whole reason the exemption is label-scoped:
# the version-keyed, all-or-nothing predicate it replaced would have swallowed
# the leak along with the legitimate registration.
<https://tbzl.dev/m/rules_partial/2.0.0> a gate:ModuleVersion, gate:RulesModule ;
    gate:name "rules_partial" ;
    gate:version "2.0.0" ;
    gate:isLatest true ;
    gate:namespacePrefix "rules_partial", "partial" ;
    gate:registersToolchain "//partial/backend:local_toolchain" ;
    gate:registersToolchain "@rust_toolchains//:all" .

[] gate:toolchainProviderFor "rules_partial" ;
   gate:providesToolchain "//partial/backend:local_toolchain" .

# --- D3: the live vpn violation, same extension as the rules_k8s bug. ---------
<https://tbzl.dev/m/vpn/0.0.1> a gate:ModuleVersion ;
    gate:name "vpn" ;
    gate:version "0.0.1" ;
    gate:isLatest true ;
    gate:namespacePrefix "vpn" ;
    gate:usesExtension <https://tbzl.dev/ext/vpn/0.0.1/0> .

<https://tbzl.dev/ext/vpn/0.0.1/0> a gate:ExtensionUsage ;
    gate:extBzlFile "@rules_oci//oci:extensions.bzl" ;
    gate:extName "oci" ;
    gate:extDev false ;
    gate:extIsForeign true ;
    gate:introducesRepo "distroless_java" ;
    gate:choseRepo "distroless_java" ;
    gate:ofModule <https://tbzl.dev/m/vpn/0.0.1> .

# D3, the NEAR MISS: identical to `vpn` above in every respect except that the
# usage is dev_dependency. A dev usage is dropped from every graph but this
# module's own, so `smoke_npm` is never in a consumer's graph and cannot collide
# with anything — the gate must NOT flag it. Without this row a regression that
# dropped the `gate:extDev false` clause would still produce the expected TSV,
# and the `_detects` diff would pass while the gate over-matched by 8 rows on
# the real registry.
<https://tbzl.dev/m/rules_devonly/1.0.0> a gate:ModuleVersion, gate:RulesModule ;
    gate:name "rules_devonly" ;
    gate:version "1.0.0" ;
    gate:isLatest true ;
    gate:namespacePrefix "rules_devonly", "devonly" ;
    gate:usesExtension <https://tbzl.dev/ext/rules_devonly/1.0.0/0> .

<https://tbzl.dev/ext/rules_devonly/1.0.0/0> a gate:ExtensionUsage ;
    gate:extBzlFile "@aspect_rules_js//npm:extensions.bzl" ;
    gate:extName "npm" ;
    gate:extDev true ;
    gate:extIsForeign true ;
    gate:introducesRepo "smoke_npm" ;
    gate:choseRepo "smoke_npm" ;
    gate:ofModule <https://tbzl.dev/m/rules_devonly/1.0.0> .

# --- C1: one atom selected at two versions across two roots. ------------------
<https://tbzl.dev/sel/a/1.0.0/rules_java> a gate:Selection ;
    gate:selectionRoot <https://tbzl.dev/m/bad_overrides/0.0.1> ;
    gate:selectionAtom "rules_java" ;
    gate:selectionVersion "8.6.1" ;
    gate:selectionExternal true .

<https://tbzl.dev/sel/b/1.0.0/rules_java> a gate:Selection ;
    gate:selectionRoot <https://tbzl.dev/m/bad_toolchain/0.0.1> ;
    gate:selectionAtom "rules_java" ;
    gate:selectionVersion "9.1.0" ;
    gate:selectionExternal true .

# --- S6: all three shapes of metadata/directory drift. ------------------------
# rules_cc_host, VERBATIM as the registry holds it: metadata and directories
# agree perfectly, and 0.1.0 — its only version — is yanked with "cannot work as
# a bazel_dep". Nothing resolves. An earlier draft of this fixture invented a
# missing directory, which would have made the gate pass against a shape the
# registry does not actually contain.
<https://tbzl.dev/mod/rules_cc_host> a gate:Module ;
    gate:name "rules_cc_host" ;
    gate:declaresVersion "0.1.0" ;
    gate:hasVersionDir "0.1.0" ;
    gate:yankedVersion "0.1.0" ;
    gate:isRegistryEntry true .

<https://tbzl.dev/mod/drifty> a gate:Module ;
    gate:name "drifty" ;
    gate:declaresVersion "1.0.0", "1.1.0" ;
    gate:hasVersionDir "1.0.0", "1.2.0" ;
    gate:isRegistryEntry true .
