    gate:sourceUrl "https://github.com/tomato-bazel/rules_jsonschema/archive/refs/tags/v0.3.0.tar.gz" ;
    gate:stripPrefix "rules_jsonschema-0.3.0" ;
    gate:dependsOn <https://tbzl.dev/m/platforms/1.0.0> ;
    gate:dependsOn <https://tbzl.dev/m/bazel_skylib/1.8.2> ;
    gate:dependsOn <https://tbzl.dev/m/rules_rust/0.70.0> ;
