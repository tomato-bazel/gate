<https://tbzl.dev/m/rules_jsonschema/0.3.0> a gate:ModuleVersion ;
    a gate:RulesModule ;
    gate:name "rules_jsonschema" ;
    gate:version "0.3.0" ;
    gate:isLatest true ;
    gate:namespacePrefix "rules_jsonschema" ;
