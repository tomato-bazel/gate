"""gate-report — project gate results into the tomato.gate.v1 report.

The generated proto types arrive as a sibling crate from rules_rust_prost
(`conformance_rs`), not from a build script, so there is no cargo build path for
this crate. That is deliberate: gate builds with Bazel, and Cargo.toml exists for
crate_universe to read.
"""

load("@gate_crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

PROTO_DEPS = ["//proto/tomato/gate/v1:conformance_rs"]

rust_library(
    name = "gate_report",
    srcs = ["src/lib.rs"],
    crate_root = "src/lib.rs",
    edition = "2021",
    deps = PROTO_DEPS + all_crate_deps(normal = True),
)

rust_test(
    name = "gate_report_test",
    crate = ":gate_report",
    edition = "2021",
)

rust_binary(
    name = "gate-report",
    srcs = ["src/main.rs"],
    crate_root = "src/main.rs",
    edition = "2021",
    deps = [":gate_report"] + PROTO_DEPS + all_crate_deps(normal = True),
)

# The PR ratchet, run by tomato-bazel/bazel-registry on every pull request.
# Compares two ConformanceReports and fails if any invariant got worse.
rust_binary(
    name = "gate-ratchet",
    srcs = ["src/ratchet.rs"],
    crate_root = "src/ratchet.rs",
    edition = "2021",
    deps = [":gate_report"] + PROTO_DEPS + all_crate_deps(normal = True),
)

exports_files(["Cargo.toml"])
